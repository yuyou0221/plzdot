DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/project_management_platform_staging?schema=public"

# staging / production must enable auth.
AUTH_ENABLED="true"
NEXT_PUBLIC_AUTH_ENABLED="true"

# Use false only for HTTP staging by IP. Use true after HTTPS is ready.
AUTH_COOKIE_SECURE="false"

# Use a long random string. Do not reuse the local example value.
AUTH_SECRET="replace-with-a-long-random-secret"

# Used only when the first admin account is created.
INITIAL_ADMIN_LOGIN="admin"
INITIAL_ADMIN_PASSWORD="replace-with-a-strong-password"
